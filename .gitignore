# Secrets — never commit
.env

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# IDE / local tooling
.vscode/
.claude/
.run/

# claude-mem auto-generated recent-activity (per-subdir CLAUDE.md only; keep top-level tracked)
expense_audit_orchestrator/profiles/**/CLAUDE.md
node_gateway/CLAUDE.md
expense_audit_orchestrator/CLAUDE.md

# Test / debug artifacts & generated outputs
output/
prepared-input.json

# Scrap / scratch graph snapshots (editor dumps). Only the pinned
# DEFAULT_GRAPH_PATH graph is tracked; the rest are local experiments.
graph-latest-* copy.json
graph-latest-*-*.json
# Official expense-audit graphs are source artifacts and must be versioned.
!graph-latest-0727-1900.json
!graph-latest-entertainment-0722.json
!graph-latest-personal-transport-0722.json
!graph-latest-travel-0807.json

# Local requirement spec sheets (not source code)
*.csv
!resources/reference/*.csv

# Empty scaffolding (auto-generated stubs only, no real code)
gorules/

# Versioned deployment templates and installer; rendered units stay local.
deploy/*
!deploy/README.md
!deploy/install.sh
!deploy/templates/
!deploy/templates/*.service
deploy/systemd-units/

# OS
.DS_Store
Thumbs.db

# Ignore local graph backup snapshots; official graph files are explicitly unignored above.
*.json.before-*
