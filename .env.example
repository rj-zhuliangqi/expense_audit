# Expense Audit 运行时环境变量
# 复制为 .env 后按服务器/环境填写真实值。.env 已被 .gitignore 排除，切勿提交真实密钥。
# 必填项若缺失，对应服务启动即失败（不会静默回退）。

# ---------------------------------------------------------------------------
# 金蝶 OCR（worker 必填；缺失 create_kingdee_ocr_provider_from_env 直接抛错）
# ---------------------------------------------------------------------------
KINGDEE_OCR_BASE_URL=https://your-kingdee-host
KINGDEE_OCR_APP_ID=RJ_EMS
KINGDEE_OCR_APP_SECRET=your-app-secret
KINGDEE_OCR_ACCOUNT_ID=19xxxxxxxx
KINGDEE_OCR_TENANT_ID=ruxxxxxx
KINGDEE_OCR_USER=RJ_EMS
# 以下为可选项，留空则用代码内默认值
KINGDEE_OCR_USER_TYPE=UserName
KINGDEE_OCR_LANGUAGE=zh-CN
KINGDEE_OCR_BILL_TYPE=er_dailyreimbursebill
KINGDEE_OCR_VERIFY_FLAG=1
KINGDEE_OCR_UPLOAD_FILE_TYPE=1
KINGDEE_OCR_RECOGNITION_FILE_TYPE=1
KINGDEE_OCR_TIMEOUT=30

# ---------------------------------------------------------------------------
# RabbitMQ（worker 必填）
# ---------------------------------------------------------------------------
# 标准格式：amqp://<user>:<password>@<host>:<port>/<vhost>，vhost 用 %2F 表示 /
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F
# 延时队列 TTL，单位毫秒；不填默认 300000
AUDIT_DELAY_TIME_MILLIS=300000

# ---------------------------------------------------------------------------
# 节点调用网关 LLM 配置（node_gateway 必填 LLM_API_KEY）
# ---------------------------------------------------------------------------
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://uniapi.ruijie.com.cn/v1
LLM_MODEL=origin-deepseek-v4-pro

# ---------------------------------------------------------------------------
# 核销单整体建议 / Overall advice（可选，默认开启；LLM 失败自动降级为不输出）
# ---------------------------------------------------------------------------
# 开关：true/false，默认 true。关闭后 ReceiptAuditService 不再调用 LLM 生成整体建议
OVERALL_ADVICE_ENABLED=true
# node_gateway 地址（图内 LLM 节点与整体建议共用同一网关）。
# 必填：未配置时启动即失败（RuntimeError），不提供任何硬编码 fallback。
# 生产环境请配置为实际网关地址，例如 http://172.16.3.231:8091
NODE_GATEWAY_URL=http://127.0.0.1:8091
# 整体建议固定复用上方 LLM_MODEL，不支持单独指定模型
# HTTP 超时秒数（默认 30）
# OVERALL_ADVICE_TIMEOUT=30
# 提示词目录（默认 expense_audit_orchestrator/prompts/）
# OVERALL_ADVICE_PROMPT_DIR=

# ---------------------------------------------------------------------------
# 真实审单网关（worker 主链路必填，不能指向 127.0.0.1/localhost/0.0.0.0）
# ---------------------------------------------------------------------------
# 也可通过 rabbitmq_worker.py --audit-service-url 覆盖
AUDIT_SERVICE_URL=https://service-uate-gw.ruijie.com.cn/

# ---------------------------------------------------------------------------
# 图运行时地址（worker 调下游 runtime 用；本地同机默认 127.0.0.1:8090）
# ---------------------------------------------------------------------------
GRAPH_RUNTIME_URL=http://127.0.0.1:8090
# systemd / start_all_services.sh 监听地址和端口；不填时使用部署模板默认值
GRAPH_RUNTIME_HOST=127.0.0.1
GRAPH_RUNTIME_PORT=8090
NODE_GATEWAY_HOST=127.0.0.1
NODE_GATEWAY_PORT=8091

# ---------------------------------------------------------------------------
# 各费用类型执行图路径（可选，留空用代码内默认值）
# ---------------------------------------------------------------------------
# 换图时在此覆盖即可，无需改代码。相对路径以项目根目录为基准。
# 通讯费（telecom）
# TELECOM_GRAPH_PATH=graph-latest-0727-1900.json
# 个人交通费（personal_transport）
# PERSONAL_TRANSPORT_GRAPH_PATH=graph-latest-personal-transport-0722.json
# 差旅（travel）—— 差旅图未就绪时留空，profile.default_graph_path 为 None
# TRAVEL_GRAPH_PATH=
# 业务招待费（entertainment）
# ENTERTAINMENT_GRAPH_PATH=graph-latest-entertainment-0722.json

# ---------------------------------------------------------------------------
# eiCode 动态路由映射表（可选，启用后 worker 按单据 eiCode 自动选 profile/图）
# ---------------------------------------------------------------------------
# 指向 ei_code_map.json 的路径；留空则用包内默认映射文件。
# 也可通过 rabbitmq_worker.py --ei-code-map-path 覆盖。
# EI_CODE_MAP_PATH=expense_audit_orchestrator/profiles/ei_code_map.json

# ---------------------------------------------------------------------------
# 通讯费资产路径（可选）
# ---------------------------------------------------------------------------
# 指向 operator_city.csv 的完整路径；留空则用包内自带资产
# TELECOM_OPERATOR_CITY_CSV=

# ---------------------------------------------------------------------------
# 发票文件下载 sysid（可选，仅 call_audit_invoice_files.py 脚本用）
# ---------------------------------------------------------------------------
AUDIT_INVOICE_FILE_SYSID=your-sysid-here
AUDIT_INVOICE_FILE_ACCESS_KEY_SECRET=your-access-key-secret-here

# ---------------------------------------------------------------------------
# 可观测性 / 日志（可选，留空用默认值）
# ---------------------------------------------------------------------------
# 日志级别：DEBUG/INFO/WARNING/ERROR，默认 INFO
LOG_LEVEL=INFO
# 结构化日志产物目录（每个单据一个子目录 output/logs/<receiptCode>/）；默认 output/logs
LOG_DIR=output/logs
# 是否开启 invoice 结果日志产物 sink，默认 true
LOG_ENABLED=true
# 是否开启 zen 图执行 trace（per-node input/output/performance），默认 true；关闭可降低开销
GRAPH_TRACE_ENABLED=true

