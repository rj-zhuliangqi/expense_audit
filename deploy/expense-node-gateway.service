[Unit]
Description=Expense Audit - Node Gateway (port 8091)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{DEPLOY_USER}}
WorkingDirectory={{DEPLOY_DIR}}
EnvironmentFile={{DEPLOY_DIR}}/.env
ExecStart={{DEPLOY_DIR}}/.venv/bin/python -m uvicorn node_gateway.api:create_app --factory --host 127.0.0.1 --port 8091
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
