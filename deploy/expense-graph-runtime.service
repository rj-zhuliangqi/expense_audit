[Unit]
Description=Expense Audit - Graph Runtime Service (port 8090)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{DEPLOY_USER}}
WorkingDirectory={{DEPLOY_DIR}}
EnvironmentFile={{DEPLOY_DIR}}/.env
ExecStart={{DEPLOY_DIR}}/.venv/bin/python -m uvicorn graph_runtime.api:create_app --factory --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5s
# 进程异常退出立即重启，连续失败每次间隔 5s

[Install]
WantedBy=multi-user.target
